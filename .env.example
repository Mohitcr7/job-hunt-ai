# Job Hunt AI — configuration
# Copy this file to .env and fill in your values:  cp .env.example .env

# ============ LLM (required) ============
# "gemini" (free tier at aistudio.google.com), "openai", or "bedrock"
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=sk-...            # only if LLM_PROVIDER=openai

# ============ AWS Bedrock (optional — set LLM_PROVIDER=bedrock) ============
# Runs the whole crew on Claude via Amazon Bedrock. Requires AWS credentials
# (aws configure) + model access enabled in the Bedrock console.
# See BEDROCK.md for the full AgentCore serverless deploy guide.
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0   # Sonnet id for quality
# GUARDRAIL_ID=                    # from: python provision_bedrock.py
# GUARDRAIL_VERSION=
# MANAGED_KB_ID=                   # optional: Managed KB replaces the FAISS layer

# ============ LLM fallback (optional — NVIDIA Nemotron via OpenRouter) ============
# If the primary provider above fails or hits a rate limit mid-run, calls
# transparently retry against NVIDIA Nemotron 3 Super on OpenRouter (chosen over
# Ultra for ~2.5x the throughput at equal $0 cost — see config.py). Get a key
# at openrouter.ai. Leave unset to disable (pipeline runs on the primary only).
# OPENROUTER_API_KEY=sk-or-...
# FALLBACK_MODEL_ID=nvidia/nemotron-3-super-120b-a12b:free
# ENABLE_LLM_FALLBACK=true
#
# PRIVACY: the ':free' endpoint logs requests and asks you not to send personal
# data — and resumes are personal data. Drop ':free' (paid) for stricter terms.
#
# Reranker (uses the same OPENROUTER_API_KEY): a free cross-encoder that narrows
# the FAISS shortlist before the LLM fit-scoring — faster matching, off the
# generation rate-limit budget. Set ENABLE_RERANK=false to disable.
# ENABLE_RERANK=true
# RERANK_MODEL_ID=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# RERANK_TOP_N=8

# ============ Your job search ============
# Comma-separated. These stay here rather than in config.py so your actual
# search preferences never end up in a commit.
# JOB_ROLES=AI/ML Engineer,Machine Learning Engineer,Data Scientist
# JOB_LOCATIONS=Bengaluru,Hyderabad,Pune,Remote
# EXPERIENCE_YEARS=0
# SALARY_MIN=0

# ============ Daily spreadsheet ============
# Written by `python main.py sheet` and the scheduled noon run.
# SHEET_OUTPUT_DIR=~/Desktop
# SHEET_TITLE=AI/ML & Data Science roles
# SHEET_HOURS=24            # how far back to scrape
# SHEET_LLM_TOP=0           # LLM-score this many top rows (0 = free run)
# SHEET_ALLOW_EMPTY=false   # true = write a sheet even when nothing was scraped.
#                           # Off by default: a zero-job scrape is nearly always
#                           # a network outage or a broken scraper, so the run
#                           # fails loudly and leaves the existing sheet alone
#                           # instead of replacing it with a header row.
# ENABLE_SHEET_RERANK=true  # cross-encoder re-orders the top of the sheet
# SHEET_RERANK_POOL=200     # how many of FAISS's best get reranked
# SHEET_STRONG_BAND=90      # percentile for "Strong"     (reranked runs)
# SHEET_REACHABLE_BAND=60   # percentile for "Reachable"  (reranked runs)
# SHEET_FAISS_STRONG_BAND=55      # cosine % for "Strong"    (rerank disabled)
# SHEET_FAISS_REACHABLE_BAND=42   # cosine % for "Reachable" (rerank disabled)

# ============ Scraping ============
# Company career-page cards give a title and a link but no description text.
# Enrichment fetches each posting through Jina Reader (free, no API key, public
# pages only) so those jobs get matched on their real description instead of a
# placeholder. Best-effort: anything that fails keeps the placeholder.
# ENABLE_PAGE_ENRICHMENT=true
# ENRICH_CONCURRENCY=3        # keep low — it's a free shared service
# ENRICH_MAX_PAGES=40         # ceiling on fetches per run
# ENRICH_TIMEOUT=25           # seconds per page

# ============ Matching ============
# Minimum fit score (0-100) for a job to get tailored materials
MATCH_THRESHOLD=70

# ============ Notifications (all optional) ============
# Slack: create a bot at api.slack.com/apps with chat:write scope
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=#job-hunt

# Email via SendGrid
# SENDGRID_API_KEY=SG....
# NOTIFY_EMAIL=you@example.com
# FROM_EMAIL=jobhunt@yourdomain.com

# ============ Quality review crew ============
# Extra LLM pass that critiques + polishes each cover letter (default on)
ENABLE_REVIEW_CREW=true

# ============ Observability (optional) ============
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=job-hunt-ai

# ============ Database ============
DATABASE_URL=sqlite:///./data/applications.db
